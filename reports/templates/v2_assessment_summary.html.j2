{# Framework v2: assessment summary (overall result, flags, persona
   heatmap, evidence coverage, backlog, strategies, references).
   Every value comes from output/scores.json, gaps.json and
   recommendations.json via reports/scripts/build_report_v2.py. #}
{% from "_v2_components.html.j2" import cover, num, ref_list %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8">
  <title>{{ t('v2.summary.title') }}: {{ organization.name or '' }}</title>
  <link rel="stylesheet" href="_print.css">
</head>
<body>
{{ cover(organization, assessment, branding, t('v2.summary.title'), t('v2.summary.subtitle')) }}

<section class="section">
  <h1>1. {{ t('v2.overall') }}</h1>
  <div class="kpi-grid">
    <div class="kpi-tile"><div class="kpi-tile__value">{{ num(overall.score) }}</div><div class="kpi-tile__label">{{ overall.label }}</div></div>
    <div class="kpi-tile"><div class="kpi-tile__value">{{ threshold.answered }} / {{ threshold.applicable }}</div><div class="kpi-tile__label">{{ t('v2.coverage') }}: {{ threshold.status }}</div></div>
    <div class="kpi-tile"><div class="kpi-tile__value">{{ assessment.respondents }}</div><div class="kpi-tile__label">{{ t('v2.respondents') }}</div></div>
    <div class="kpi-tile"><div class="kpi-tile__value">{{ '-' if evidence.share is none else ((evidence.share * 100) | round | int) ~ '%' }}</div><div class="kpi-tile__label">{{ t('v2.evidence_coverage') }}</div></div>
  </div>
  {% if threshold.status == 'BLOCKED' %}<p class="inline-warning">{{ t('v2.blocked') }}</p>{% endif %}
  <p class="text-muted">{{ t('v2.method', ok=scoring.coverage_ok_min, warn=scoring.coverage_warning_min) }}</p>

  <h2>1.1 {{ t('v2.flags') }}</h2>
  <ul class="v2-flags">
    {% if flags.amplification_risk %}
    <li class="critical"><b>{{ t('v2.flag.amplification') }}:</b> {% for a in flags.amplification_risk %}{{ a.dimension_id }} ({{ a.level }}){{ ', ' if not loop.last }}{% endfor %}. {{ t('v2.flag.amplification_why', overall=overall.level) }}</li>
    {% else %}<li class="ok"><b>{{ t('v2.flag.amplification') }}:</b> {{ t('v2.flag.none') }}</li>{% endif %}
    {% set pg = flags.perception_gap %}
    {% if pg.status == 'insufficient_sample' %}
    <li><b>{{ t('v2.flag.perception') }}:</b> {{ t('v2.flag.perception_insufficient', e=pg.executive_n, h=pg.hands_on_n, n=pg.min_n) }}</li>
    {% elif pg.dimensions %}
    <li class="critical"><b>{{ t('v2.flag.perception') }}:</b> {% for d in pg.dimensions %}{{ d.dimension_id }} ({{ num(d.executive_score) }} / {{ num(d.hands_on_score) }}){{ ', ' if not loop.last }}{% endfor %}. {{ t('v2.flag.perception_why') }}</li>
    {% else %}<li class="ok"><b>{{ t('v2.flag.perception') }}:</b> {{ t('v2.flag.none') }}</li>{% endif %}
    {% if flags.respondent_divergence %}
    <li><b>{{ t('v2.flag.divergence') }}:</b> {% for d in flags.respondent_divergence %}{{ d.dimension_id }} ({{ t('v2.sd') }} {{ num(d.sd) }}, {{ num(d.min) }} {{ t('v2.to') }} {{ num(d.max) }}){{ ', ' if not loop.last }}{% endfor %}. {{ t('v2.flag.divergence_why') }}</li>
    {% endif %}
    {% if flags.low_confidence %}
    <li><b>{{ t('v2.flag.low_confidence') }}:</b> {{ flags.low_confidence | join(', ') }}. {{ t('v2.flag.low_confidence_why') }}</li>
    {% endif %}
    {% if flags.scope_caveat.flagged %}
    <li><b>{{ t('v2.flag.scope') }}:</b> {{ t('v2.flag.scope_why', share=((flags.scope_caveat.single_team_share * 100) | round | int)) }}</li>
    {% endif %}
    {% if evidence.unverified_questions %}
    <li><b>{{ t('v2.flag.unverified') }}:</b> {{ evidence.unverified_questions | join(', ') }}. {{ t('v2.flag.unverified_why') }}</li>
    {% endif %}
  </ul>
</section>

<section class="section">
  <h1>2. {{ t('v2.dimensions') }}</h1>
  <table class="v2-table">
    <tr><th>ID</th><th>{{ t('v2.dimension') }}</th><th class="num">{{ t('v2.score') }}</th><th>{{ t('v2.level') }}</th><th class="num">{{ t('v2.answered') }}</th><th class="num">NA</th><th>{{ t('v2.priority') }}</th></tr>
    {% for d in dimensions %}
    <tr><td>{{ d.id }}</td><td>{{ d.name }}{% if d.low_confidence %} <span class="tag-unverified">{{ t('v2.low_conf_short') }}</span>{% endif %}</td>
      <td class="num {{ d.heat }}">{{ num(d.score) }}</td><td>{{ d.label }}</td>
      <td class="num">{{ d.answered }} / {{ d.applicable }}</td>
      <td class="num">{{ '-' if d.na_share is none else ((d.na_share * 100) | round | int) ~ '%' }}</td>
      <td>{{ d.gap.priority if d.gap else '-' }}</td></tr>
    {% endfor %}
  </table>

  <h2>2.1 {{ t('v2.heatmap') }}</h2>
  {% if personas %}
  <table class="v2-table v2-heatmap">
    <tr><th>{{ t('v2.dimension') }}</th><th>{{ t('v2.all') }}</th>{% for p in personas %}<th>{{ p.persona }}<br><span class="text-faint">n={{ p.n }}{% if p.low_sample %} · {{ t('v2.low_sample') }}{% endif %}</span></th>{% endfor %}</tr>
    {% for row in heatmap %}
    <tr><th>{{ row.id }}</th><td class="{{ row.overall_heat }}">{{ num(row.overall) }}</td>{% for c in row.cells %}<td class="{{ c.heat }}">{{ num(c.score) }}</td>{% endfor %}</tr>
    {% endfor %}
  </table>
  <p class="text-faint">{{ t('v2.heatmap_note', n=scoring.persona_min_n) }}</p>
  {% else %}<p class="text-muted">{{ t('v2.no_personas') }}</p>{% endif %}

  <h2>2.2 {{ t('v2.cross.title') }}</h2>
  {% if not checks.repo and not checks.telemetry and not checks.delivery %}<p class="text-muted">{{ t('v2.cross.none') }}</p>{% endif %}
  {% if checks.repo %}{% set r = checks.repo %}
  <h3>{{ t('v2.cross.repo') }}</h3>
  <p>{{ t('v2.cross.repo_text', n=r.repositories, l1=r.levels.L1, l2=r.levels.L2, l3=r.levels.L3, l4=r.levels.L4, share=((r.share_l2_or_higher * 100) | round | int), implied=r.d4q4.implied_level) }}
  {% if r.instruction_files_checked %}{{ t('v2.cross.repo_once', once=r.instruction_files_committed_once, checked=r.instruction_files_checked) }}{% endif %}
  {{ t('v2.cross.repo_l3', share=((r.share_l3_or_higher * 100) | round | int)) }}</p>
  <p>{{ t('v2.cross.assessed', qid='D4-Q4', score=num(r.d4q4.score), level=(r.d4q4.level or '-')) }} {{ t('v2.cross.assessed', qid='D4-Q5', score=num(r.d4q5.score), level=(r.d4q5.level or '-')) }}
  {% if r.d4q4.flag %}<span class="tag-unverified">{{ t('v2.cross.flag', qid='D4-Q4') }}</span>{% else %}<span class="text-muted">{{ t('v2.cross.ok') }}</span>{% endif %}</p>
  {% endif %}
  {% if checks.telemetry %}{% set m = checks.telemetry %}
  <h3>{{ t('v2.cross.tel') }}</h3>
  <p>{{ t('v2.cross.tel_text', day=(m.report_day or '-'), pop=m.population, code=(((m.shares.code_first_or_higher or 0) * 100) | round | int), agent=(((m.shares.agent_first_or_higher or 0) * 100) | round | int), multi=(((m.shares.multi_agent or 0) * 100) | round | int), implied=(m.d4q1.implied_level or '-')) }}
  {% if m.shares.monthly_active_of_seats is not none %}{{ t('v2.cross.tel_seats', share=((m.shares.monthly_active_of_seats * 100) | round | int), seats=m.seats) }}{% endif %}
  {{ t('v2.cross.tel_d9') }}</p>
  <p>{{ t('v2.cross.assessed', qid='D4-Q1', score=num(m.d4q1.score), level=(m.d4q1.level or '-')) }} {{ t('v2.cross.assessed', qid='D9-Q1', score=num(m.d9q1.score), level=(m.d9q1.level or '-')) }}
  {% if m.d4q1.flag %}<span class="tag-unverified">{{ t('v2.cross.flag', qid='D4-Q1') }}</span>{% else %}<span class="text-muted">{{ t('v2.cross.ok') }}</span>{% endif %}</p>
  {% endif %}
  {% if checks.delivery %}{% set dm = checks.delivery %}
  <h3>{{ t('v2.cross.dora') }}</h3>
  <p>{{ t('v2.cross.dora_text', listed=dm.services_listed, measured=dm.services_measured, compared=dm.services_compared) }}
  {% if dm.services_total %}{{ t('v2.cross.dora_share', total=dm.services_total, share=(((dm.shares.compared or 0) * 100) | round | int), implied=dm.d9q2.implied_level) }}{% else %}{{ t('v2.cross.dora_no_total') }}{% endif %}</p>
  <p>{{ t('v2.cross.assessed', qid='D9-Q2', score=num(dm.d9q2.score), level=(dm.d9q2.level or '-')) }}
  {% if dm.d9q2.flag %}<span class="tag-unverified">{{ t('v2.cross.flag', qid='D9-Q2') }}</span>{% elif dm.services_total %}<span class="text-muted">{{ t('v2.cross.ok') }}</span>{% endif %}</p>
  {% endif %}

  {% if survey %}
  <h2>2.3 {{ t('v2.survey.title') }}</h2>
  <p class="text-muted">{{ t('v2.survey.intro', file=survey.source, n=(survey.respondents or '-')) }}</p>
  <table class="v2-table wrap-first">
    <tr><th>{{ t('v2.survey.dim') }}</th><th class="num">{{ t('v2.survey.team') }}</th><th>{{ t('v2.survey.related') }}</th></tr>
    {% for r in survey.rows %}
    <tr><td><b>{{ r.id }}</b> {{ r.name }}</td><td class="num">{{ num(r.score) }}{% if r.label %}<br><span class="text-faint">{{ r.label }}</span>{% endif %}</td>
      <td>{% for q in r.questions %}{{ q.id }} ({{ num(q.score) }}){{ ', ' if not loop.last }}{% endfor %}</td></tr>
    {% endfor %}
  </table>
  {% endif %}
</section>

<section class="section">
  <h1>3. {{ t('v2.backlog') }}</h1>
  <p class="text-muted">{{ t('v2.backlog_intro') }}</p>
  <table class="v2-table">
    <tr><th>ID</th><th>{{ t('v2.question') }}</th><th class="num">{{ t('v2.score') }}</th><th>{{ t('v2.l3_target') }}</th><th>{{ t('v2.basis') }}</th></tr>
    {% for b in backlog %}
    <tr><td>{{ b.question_id }}</td><td>{{ b.title }}</td><td class="num">{{ num(b.score) }}</td><td>{{ b.l3_anchor }}</td><td>{% for n in b.basis %}[{{ n }}]{% endfor %}</td></tr>
    {% endfor %}
  </table>

  <h2>3.1 {{ t('v2.strategies') }}</h2>
  <table class="v2-table">
    <tr><th>#</th><th>{{ t('v2.strategy') }}</th><th class="num">{{ t('v2.cumulative') }}</th><th>{{ t('v2.priority') }}</th><th>{{ t('v2.horizon') }}</th><th>{{ t('v2.first_action') }}</th><th>{{ t('v2.basis') }}</th></tr>
    {% for s in strategies %}
    <tr><td>{{ s.rank }}</td><td>{{ s.strategy_id }} {{ s.strategy_name }}<br><span class="text-faint">{% for d in s.related_dimensions %}{{ d.id }}{{ ', ' if not loop.last }}{% endfor %}</span></td>
      <td class="num">{{ num(s.cumulative_priority) }}</td><td>{{ s.max_priority }}</td><td>{{ s.horizon }}</td><td>{{ s.first_action }}</td><td>{% for n in s.references %}[{{ n }}]{% endfor %}</td></tr>
    {% endfor %}
  </table>
  {% if skipped_strategies %}<p class="text-faint">{{ t('v2.skipped') }}: {% for s in skipped_strategies %}{{ s.strategy_id }} ({{ s.reason }}){{ ', ' if not loop.last }}{% endfor %}</p>{% endif %}
</section>

<section class="section">
  <h1>4. {{ t('v2.method_title') }}</h1>
  <table class="v2-table">
    <tr><th>{{ t('v2.level') }}</th><th>{{ t('v2.band') }}</th></tr>
    {% for b in level_bands %}<tr><td>{{ b.level }} {{ level_names[b.level] }}</td><td>{{ interval(b.min, b.max, loop.last) }}</td></tr>{% endfor %}
  </table>
  <p class="text-muted">{{ t('v2.method_rules', target=fmt(scoring.default_target, 1)) }}</p>
  <p class="text-muted">{{ t('v2.limitations') }}</p>
</section>

<section class="section">
  <h1>5. {{ t('v2.references') }}</h1>
  {{ ref_list(references) }}
</section>
</body>
</html>
