{# Round comparison (scripts/compare_rounds.py --pdf).
   Context: result from compare_rounds plus cover data. #}
{% from "_v2_components.html.j2" import cover, num %}
{% macro delta(v) %}{% if v is none %}-{% else %}<span class="{{ 'v2-up' if v > 0 else ('v2-down' if v < 0 else '') }}">{{ '+' if v > 0 else '' }}{{ fmt(v) }}</span>{% endif %}{% endmacro %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8">
  <title>{{ t('v2.cmp.title') }}: {{ organization.name or '' }}</title>
  <link rel="stylesheet" href="_print.css">
</head>
<body>
{{ cover(organization, assessment, branding, t('v2.cmp.title'), t('v2.cmp.subtitle.' ~ result.mode)) }}

<section class="section">
  <h1>1. {{ t('v2.cmp.overall') }}</h1>
  <div class="kpi-grid">
    <div class="kpi-tile"><div class="kpi-tile__value">{{ num(result.overall.before) }}</div><div class="kpi-tile__label">{{ t('v2.cmp.before') }}</div></div>
    <div class="kpi-tile"><div class="kpi-tile__value">{{ num(result.overall.after) }}</div><div class="kpi-tile__label">{{ t('v2.cmp.after') }}</div></div>
    <div class="kpi-tile"><div class="kpi-tile__value">{{ delta(result.overall.delta) }}</div><div class="kpi-tile__label">{{ t('v2.cmp.delta') }}</div></div>
  </div>
  {% if result.mode == 'v1-v2' %}
  <ul class="v2-flags">
    <li>{{ t('v2.cmp.caveat.v1v2_1') }}</li>
    <li>{{ t('v2.cmp.caveat.v1v2_2') }}</li>
    <li>{{ t('v2.cmp.no_overall') }}</li>
  </ul>
  {% endif %}
  <p class="text-muted">{{ t('v2.cmp.method') }}</p>
</section>

<section class="section">
  <h1>2. {{ t('v2.cmp.units_' ~ ('pillars' if result.mode == 'v1-v1' else 'dimensions')) }}</h1>
  <table class="v2-table">
    <tr><th>ID</th><th>{{ t('v2.cmp.name') }}</th>{% if result.mode == 'v1-v2' %}<th class="num">{{ t('v2.cmp.comparable') }}</th>{% endif %}<th class="num">{{ t('v2.cmp.before') }}</th><th class="num">{{ t('v2.cmp.after') }}</th><th class="num">{{ t('v2.cmp.delta') }}</th></tr>
    {% for u in result.units %}
    <tr><td>{{ u.id }}</td><td>{{ u.name }}</td>{% if result.mode == 'v1-v2' %}<td class="num">{{ u.comparable_questions }}</td>{% endif %}<td class="num">{{ num(u.before) }}</td><td class="num">{{ num(u.after) }}</td><td class="num">{{ delta(u.delta) }}</td></tr>
    {% endfor %}
  </table>
</section>

{% set moved = result.questions | selectattr('delta', 'ne', none) | sort(attribute='delta') | list %}
{% if moved %}
<section class="section">
  <h1>3. {{ t('v2.cmp.questions') }}</h1>
  <h2>3.1 {{ t('v2.cmp.drops') }}</h2>
  <table class="v2-table">
    <tr><th>{{ t('v2.cmp.question') }}</th>{% if result.mode == 'v1-v2' %}<th>{{ t('v2.cmp.v1_ids') }}</th>{% endif %}<th class="num">{{ t('v2.cmp.before') }}</th><th class="num">{{ t('v2.cmp.after') }}</th><th class="num">{{ t('v2.cmp.delta') }}</th></tr>
    {% for q in moved[:5] %}<tr><td>{{ q.id }}</td>{% if result.mode == 'v1-v2' %}<td>{{ q.v1_ids | join(', ') }}{% if q.partial %} *{% endif %}</td>{% endif %}<td class="num">{{ num(q.before) }}</td><td class="num">{{ num(q.after) }}</td><td class="num">{{ delta(q.delta) }}</td></tr>{% endfor %}
  </table>
  <h2>3.2 {{ t('v2.cmp.gains') }}</h2>
  <table class="v2-table">
    <tr><th>{{ t('v2.cmp.question') }}</th>{% if result.mode == 'v1-v2' %}<th>{{ t('v2.cmp.v1_ids') }}</th>{% endif %}<th class="num">{{ t('v2.cmp.before') }}</th><th class="num">{{ t('v2.cmp.after') }}</th><th class="num">{{ t('v2.cmp.delta') }}</th></tr>
    {% for q in (moved[-5:] | reverse) %}<tr><td>{{ q.id }}</td>{% if result.mode == 'v1-v2' %}<td>{{ q.v1_ids | join(', ') }}{% if q.partial %} *{% endif %}</td>{% endif %}<td class="num">{{ num(q.before) }}</td><td class="num">{{ num(q.after) }}</td><td class="num">{{ delta(q.delta) }}</td></tr>{% endfor %}
  </table>
  {% if result.mode == 'v1-v2' %}<p class="text-faint">{{ t('v2.cmp.partial') }}</p>{% endif %}
</section>
{% endif %}
</body>
</html>
