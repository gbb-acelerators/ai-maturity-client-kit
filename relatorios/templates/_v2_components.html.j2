{# Shared macros for the framework v2 reports. #}
{% macro ms_logo() %}<svg class="ms-logo" viewBox="0 0 23 23" role="img" aria-label="Microsoft"><rect x="1" y="1" width="10" height="10" fill="#F25022"/><rect x="12" y="1" width="10" height="10" fill="#7FBA00"/><rect x="1" y="12" width="10" height="10" fill="#00A4EF"/><rect x="12" y="12" width="10" height="10" fill="#FFB900"/></svg>{% endmacro %}

{% macro num(v) %}{{ '-' if v is none else '%.2f' | format(v) }}{% endmacro %}

{% macro cover(organization, assessment, branding, title, subtitle) %}
<section class="cover">
  <header class="cover__brand">{{ ms_logo() }}<span class="cover__platform">{{ branding.author }} | {{ branding.role }}</span></header>
  <div class="cover__main">
    <div class="cover__customer">{{ organization.name or t('label.not_specified') }}</div>
    <h1 class="cover__title">{{ title }}</h1>
    <h2 class="cover__subtitle">{{ subtitle }}</h2>
  </div>
  <div>
    <dl class="cover__meta">
      <dt>{{ t('meta.assessment_date') }}</dt><dd>{{ assessment.date }}</dd>
      <dt>{{ t('meta.framework_version') }}</dt><dd>{{ assessment.framework_version }}</dd>
      <dt>{{ t('v2.respondents') }}</dt><dd>{{ assessment.respondents }}</dd>
      <dt>{{ t('meta.generated_date') }}</dt><dd>{{ assessment.generated }}</dd>
    </dl>
    <div class="cover__footer">{{ t('footer.confidential', org=(organization.name or t('label.not_specified'))) }}</div>
  </div>
</section>
{% endmacro %}

{% macro ref_list(refs) %}
<ol class="v2-refs">
{% for r in refs %}<li value="{{ r.n }}">{{ r.text }}</li>{% endfor %}
</ol>
{% endmacro %}
