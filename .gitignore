# ============================================================================
# AI Maturity Assessment Kit: .gitignore
# ============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
venv/
.venv/
env/
.env

# Editors / OS
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/settings.json.example

# Outputs the client generates (kept clean for fresh clones)
output/*
!output/.gitkeep

# Client-specific input files (do NOT commit real client data)
responses.json
responses.json.backup-*
forms-responses.xlsx
survey-devs-responses.xlsx
survey-learning-responses.xlsx
implementation-guide-inputs.json
survey-devs/responses-devs.json
survey-learning/responses-learning.json

# Names used by kits before 2.0.2 (keep ignoring old client files)
saida/
respostas.json
respostas.json.backup-*
respostas-forms.xlsx
respostas-survey-devs.xlsx
respostas-survey-learning.xlsx
survey-devs/respostas-devs.json
survey-learning/respostas-learning.json

# Build artifacts
*.log
build/
dist/
docs/downloads/
